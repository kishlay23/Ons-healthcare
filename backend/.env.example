# ── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=5000

# ── Database (PostgreSQL) ─────────────────────────────────────────────────────
# Get this from Neon / Supabase / Railway / Render PostgreSQL
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_64_char_random_hex
JWT_EXPIRE=24h
REFRESH_TOKEN_SECRET=replace_with_another_64_char_random_hex
REFRESH_TOKEN_EXPIRE=7d

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
CORS_ORIGIN=https://your-frontend.vercel.app

# ── Email ─────────────────────────────────────────────────────────────────────
# Provider: resend | ses | azure  (resend is default)
EMAIL_PROVIDER=resend

# Resend: get API key from https://resend.com/api-keys
RESEND_API_KEY=re_your_resend_api_key_here

# "From" address (domain must be verified in Resend)
EMAIL_FROM=ONS Healthcare <noreply@yourdomain.com>

# Public URL of the frontend (used to build password reset links)
FRONTEND_URL=https://your-frontend.vercel.app
