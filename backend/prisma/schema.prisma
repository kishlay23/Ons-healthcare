generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Users ────────────────────────────────────────────────────────────────────

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  phone     String   @unique
  password  String
  firstName String
  lastName  String
  age       Int?
  gender    String?
  address   String?
  role      String   @default("PATIENT") // PATIENT | THERAPIST | ADMIN
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  appointments   Appointment[]
  stories        PatientStory[]
  therapist      Therapist?
  passwordResets PasswordReset[]

  @@map("users")
}

// ── Password Resets ───────────────────────────────────────────────────────────

model PasswordReset {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique  // SHA-256 of the raw token (never stored plain)
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("password_resets")
}

// ── Therapists ────────────────────────────────────────────────────────────────

model Therapist {
  id              String @id @default(uuid())
  userId          String @unique
  user            User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  licenseNumber   String @unique
  specialization  String
  experienceYears Int
  qualifications  String?
  bio             String?
  profilePhoto    String?

  appointments Appointment[]
  schedules    TherapistSchedule[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("therapists")
}

model TherapistSchedule {
  id          String    @id @default(uuid())
  therapistId String
  therapist   Therapist @relation(fields: [therapistId], references: [id], onDelete: Cascade)

  dayOfWeek   Int     // 0=Sun … 6=Sat
  startTime   String  // HH:MM
  endTime     String  // HH:MM
  breakStart  String?
  breakEnd    String?
  isAvailable Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([therapistId, dayOfWeek])
  @@map("therapist_schedules")
}

// ── Treatments & Machines ─────────────────────────────────────────────────────

model Treatment {
  id               String  @id @default(uuid())
  name             String  @unique
  description      String
  specialty        String  // Ortho | Neuro | Sports
  durationMinutes  Int
  standardSessions Int
  benefits         String[]
  conditions       String[]
  pricePerSession  Float

  machines     TreatmentMachine[]
  appointments Appointment[]
  pricing      Pricing?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("treatments")
}

model Machine {
  id             String @id @default(uuid())
  name           String
  brand          String
  model          String
  description    String
  imageUrl       String?
  specialty      String
  certifications String[]
  acquiredDate   DateTime

  treatments TreatmentMachine[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("machines")
}

model TreatmentMachine {
  id          String    @id @default(uuid())
  treatmentId String
  treatment   Treatment @relation(fields: [treatmentId], references: [id], onDelete: Cascade)
  machineId   String
  machine     Machine   @relation(fields: [machineId], references: [id], onDelete: Cascade)
  usageOrder  Int       @default(1)

  @@unique([treatmentId, machineId])
  @@map("treatment_machines")
}

// ── Pricing ───────────────────────────────────────────────────────────────────

model Pricing {
  id                 String    @id @default(uuid())
  treatmentId        String    @unique
  treatment          Treatment @relation(fields: [treatmentId], references: [id], onDelete: Cascade)

  singleSessionPrice Float
  package5Price      Float
  package10Price     Float
  offerPrice         Float?
  validFrom          DateTime?
  validTo            DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("pricing")
}

// ── Appointments ──────────────────────────────────────────────────────────────

model Appointment {
  id              String    @id @default(uuid())

  patientId       String
  patient         User      @relation(fields: [patientId], references: [id], onDelete: Cascade)

  therapistId     String
  therapist       Therapist @relation(fields: [therapistId], references: [id])

  treatmentId     String
  treatment       Treatment @relation(fields: [treatmentId], references: [id])

  appointmentDate DateTime
  appointmentTime String   // HH:MM
  status          String   @default("PENDING") // PENDING|CONFIRMED|COMPLETED|CANCELLED|RESCHEDULED

  notes           String?
  cancelledAt     DateTime?
  cancelledReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("appointments")
}

// ── Patient Stories ───────────────────────────────────────────────────────────

model PatientStory {
  id        String  @id @default(uuid())

  patientId String
  patient   User    @relation(fields: [patientId], references: [id], onDelete: Cascade)

  title     String?
  storyText String
  condition String
  specialty String
  photoUrl  String?
  videoUrl  String?
  rating    Int     // 1–5

  status      String   @default("PENDING")  // PENDING|PUBLISHED|REJECTED|ARCHIVED
  featured    Boolean  @default(false)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  publishedAt DateTime?

  @@map("patient_stories")
}
